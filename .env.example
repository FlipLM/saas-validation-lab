# ==============================================================================
# SAAS VALIDATION LAB - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# NUNCA PERSISTA CREDENCIAIS REAIS NESTE ARQUIVO OU NO CONTROLE DE VERSÃO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP & AMBIENTE
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=super-secret-saas-validator-jwt-key-minimum-32-chars-long

# ------------------------------------------------------------------------------
# 2. PERSISTÊNCIA & BANCO DE DADOS
# ------------------------------------------------------------------------------
# SQLite com WAL ativo para robustez e zero configuração externa inicial
DATABASE_URL=file:../data/saas_validator.db
# Para PostgreSQL futuro (se habilitado): postgresql://user:password@localhost:5432/saas_validator

# ------------------------------------------------------------------------------
# 3. ORQUESTRADOR E WORKER AUTÔNOMO
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_INTERVAL_MS=10000
GLOBAL_AUTOMATION_PAUSED=false

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO TELEGRAM (API OFICIAL)
# ------------------------------------------------------------------------------
# Obtenha com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
# ID do chat ou canal para envio de alertas e relatórios
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ------------------------------------------------------------------------------
# 5. INTEGRAÇÃO PENTAGI (PLATAFORMA DE SEGURANÇA OFENSIVA AUTORIZADA)
# ------------------------------------------------------------------------------
# URL base da instância PentAGI (vxcontrol/pentagi)
PENTAGI_API_URL=http://localhost:8080
PENTAGI_API_KEY=<PENTAGI_API_KEY>
PENTAGI_ENABLED=false
PENTAGI_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 6. LIMITES DE SEGURANÇA & OPERAÇÃO
# ------------------------------------------------------------------------------
MAX_EXECUTION_TIME_MS=300000
MAX_RETRIES_PER_TASK=3
REQUIRE_MANUAL_APPROVAL_FOR_HIGH_RISK=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
